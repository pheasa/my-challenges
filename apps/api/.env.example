# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Django secret key — REQUIRED by the API entrypoint (configure_instance).
# setup.sh generates one automatically and appends it to apps/api/.env;
# keep it stable across restarts so sessions and tokens survive. Generate with:
#   python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"

# Database Settings
# Primary database connection string (DATABASE_URL is the single source of truth for backend services)
DATABASE_URL="postgresql://plane:plane@localhost:5432/plane"

# Database connection pooling & health checks (optional)
CONN_MAX_AGE=0
CONN_HEALTH_CHECKS=0

# Redis Settings
# Redis runs on the same docker network — the URL is the single source of truth.
REDIS_URL="redis://plane-redis:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
# MinIO runs on the same docker network — use the service name, not localhost
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# Email redirections and minio domain settings
# Must be the externally reachable site URL (in the compose stack this is the
# proxy, e.g. http://localhost or your domain) — file/upload URLs are built
# from it when USE_MINIO=1.
WEB_URL="http://localhost"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# ===== Feature flags =====
# These are read by `python manage.py configure_instance` at API boot and stored
# in the instance_configurations table. With a fresh database every flag below
# takes effect on first boot. To apply changes later, toggle them in God Mode
# (admin UI) or update the instance_configurations rows.
#
# Note: third-party OAuth login (Google / GitHub / GitLab / Gitea) has been
# removed — the login screens only offer email/password and magic link.

# Authentication
ENABLE_SIGNUP=1
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK_LOGIN=1
DISABLE_WORKSPACE_CREATION=0

# SMTP (required to actually send magic-link / invite / notification emails)
ENABLE_SMTP=1
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM="Team Plane <team@mailer.plane.so>"
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# AI / LLM (set LLM_API_KEY to activate AI features)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
